PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# ---- TURN server (REQUIRED for production) --------------------------------
# Without TURN, ~10-20% of video connections fail (users behind strict NATs).
# Get free credentials from https://www.metered.ca/tools/openrelay/ or run
# your own coturn. Leave blank in local dev (STUN alone usually works on LAN).
# TURN_URL=turn:your-turn-host:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
